{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["ES2022"],
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@opencode-ai/plugin": ["../../node_modules/@opencode-ai/plugin"],
      "@opencode-ai/sdk": ["../../node_modules/@opencode-ai/sdk"]
    }
  },
  "include": ["index.ts"],
  "exclude": ["node_modules", "dist"]
}